# ACE Exchange V6 — production integration template
# Never commit real secrets. Configure real production values in Vercel Environment Variables.

# Application
NEXT_PUBLIC_APP_URL=https://www.aceexchange.io
APP_ENV=production
NEXT_PUBLIC_TERMS_VERSION=2026-09-06
NEXT_PUBLIC_PRIVACY_VERSION=2026-09-06

# Core data / operations
# Legacy database variable; not used by the Better Auth Preview foundation.
DATABASE_URL=
# Preview-only migration URL. Map from ACE_NEON_DATABASE_URL_UNPOOLED; never fall back to DATABASE_URL.
DATABASE_URL_DIRECT=
# Preview-only Better Auth runtime URL. Construct a new pooled URL for ace_exchange_runtime using the ACE_NEON_DATABASE_URL host/database; never fall back to DATABASE_URL.
BETTER_AUTH_DATABASE_URL=
MONITORING_DSN=
AUDIT_SERVICE_URL=
AUDIT_SERVICE_TOKEN=
INTERNAL_STATUS_TOKEN=

# Authentication / identity
# `legacy` preserves AUTH_SERVICE_URL transport. Switch only after Better Auth cutover validation.
AUTH_MODE=legacy
# Better Auth signing secret and canonical deployment URL. Both are required before AUTH_MODE=better-auth.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
AUTH_SERVICE_URL=
AUTH_SERVICE_TOKEN=
AUTH_SESSION_PATH=session
AUTH_ADMIN_ROLES=admin,super_admin
EMAIL_API_URL=
EMAIL_API_KEY=
SMS_API_URL=
SMS_API_KEY=

# Ledger
LEDGER_SERVICE_URL=
LEDGER_SERVICE_TOKEN=

# Custody / wallet
CUSTODY_API_URL=
CUSTODY_API_KEY=

# Mainnet health / RPC overrides
# These are health/reachability checks only — never treat public RPC endpoints as custody infrastructure.
BITCOIN_HEALTH_URL=
ETH_RPC_URL=
SOLANA_RPC_URL=

# Market data
# If unset, ACE can use the public read-only fallback for market preview/quotes only.
MARKET_DATA_PROVIDER_URL=
MARKET_DATA_PROVIDER_TOKEN=

# Trading / liquidity
TRADING_EXECUTION_URL=
TRADING_EXECUTION_TOKEN=

# KYC / AML
KYC_PROVIDER_URL=
KYC_PROVIDER_KEY=
AML_PROVIDER_URL=
AML_PROVIDER_KEY=

# Fiat / card
FIAT_PROVIDER_URL=
FIAT_PROVIDER_KEY=
CARD_PROVIDER_URL=
CARD_PROVIDER_KEY=

# Governance / community / creator backend adapters
GOVERNANCE_API_URL=
GOVERNANCE_API_TOKEN=
COMMUNITY_API_URL=
COMMUNITY_API_TOKEN=
CREATOR_API_URL=
CREATOR_API_TOKEN=

# Feature flags — fail closed by default
ENABLE_ADMIN_DASHBOARD=false
ENABLE_TRADING=false
ENABLE_ADVANCED_TRADING=false
ENABLE_DEPOSITS=false
ENABLE_WITHDRAWALS=false
ENABLE_FIAT=false
ENABLE_CARD=false
ENABLE_GOVERNANCE_VOTING=false
ENABLE_CREATOR_PAYOUTS=false
ENABLE_MARKETPLACE=false
ENABLE_COMMUNITY_WRITES=false

# Distributed rate limiting / abuse controls
RATE_LIMIT_SERVICE_URL=
RATE_LIMIT_SERVICE_TOKEN=

# Explicit release approvals — NEVER default these to true in source.
# Enable only after the corresponding owner has signed off in production.
CONTROLLED_BETA_APPROVED=false
LEGAL_LAUNCH_APPROVED=false
OPERATIONS_LAUNCH_APPROVED=false
SECURITY_LAUNCH_APPROVED=false
FINANCIAL_PROVIDER_VALIDATION_APPROVED=false

# User onboarding gate
ENABLE_REGISTRATION=false

# ACE liquidity router V1: only the exact value "simulation" enables simulations; every other value fails closed.
ACE_LIQUIDITY_EXECUTION_MODE=simulation

# ACE liquidity router V2: server-only Ethereum mainnet read endpoint. Never expose this URL to browser code.
ETHEREUM_RPC_URL=
MAX_QUOTE_AGE_SECONDS=15

# Reward Funding Engine V3: only simulation is accepted; missing/other values fail closed.
ACE_REWARD_EXECUTION_MODE=simulation

# V4A Preview-only persistent financial foundation. Do not add these to Production.
AUTH_MODE=better-auth
ACE_DATABASE_URL=
ACE_CUSTODY_WEBHOOK_SECRET=
